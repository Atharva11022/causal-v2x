# Environment
venv/
__pycache__/
*.pyc
.DS_Store

# Data (large / regenerable — do not commit)
data/*.csv
data/*.zip
data/*.txt
data/*.pdf
data/*.htm

# Model weights & intermediate arrays (regenerable via scripts)
outputs/*.pt
outputs/*.npy

# Keep the plots and summary CSVs — these are your evidence, commit them
!outputs/*.png
!outputs/evaluation_summary.csv
!outputs/causal_edges_v2x.csv
!outputs/performance_metrics.csv

# Kaggle credentials — NEVER commit this
kaggle.json

# VSCode
.vscode/*
!.vscode/settings.json
